{
  "name": "@signature-studio/engine",
  "version": "1.0.0",
  "private": true,
  "description": "Builds Outlook-safe HTML email signatures with canvas-rendered images. Framework-free, runs in the browser.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./check": "./src/check.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run --project unit --project golden",
    "test:golden": "vitest run --project golden",
    "test:watch": "vitest --project unit",
    "test:audit": "vitest run --project audit",
    "data:handwriting": "node scripts/build-handwriting.ts",
    "data:check": "node scripts/build-handwriting.ts --check && node scripts/build-sample-photo.ts --check",
    "data:photo": "node scripts/build-sample-photo.ts"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.65.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
